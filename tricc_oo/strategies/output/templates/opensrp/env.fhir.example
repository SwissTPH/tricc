# Template for credentials / endpoints (never commit real secrets).
# OpenSRPStrategy copies this to `.env` only when `.env` is missing (re-export safe).
# You may also use `.secrets` (later wins over `.env`).
# Load order: existing env → .env → .secrets
#
#   # if needed: cp env.fhir.example .env
#   # edit .env / put secrets in .secrets

# --- FHIR endpoint ---
# Gateway (auth + App-Id):  https://host/fhir
# HAPI direct (no auth):    http://localhost:8082/fhir  or  http://hapi:8080/fhir
FHIR_BASE_URL=https://194.182.171.88/fhir

# OpenSRP app id for gateway ACL (Composition.identifier). Not the local "…/debug" id.
APP_ID=cdss

# --- Auth (skip for HAPI direct) ---
# SKIP_AUTH=1          # no Bearer / App-Id (HAPI open or internal network)
SKIP_AUTH=0

# Keycloak (password grant) — used when SKIP_AUTH=0
KEYCLOAK_BASE_URL=https://194.182.171.88
KEYCLOAK_REALM=opensrp
KEYCLOAK_CLIENT_ID=fhir-core-client
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_USER=demo
KEYCLOAK_PASSWORD=demo

# Optional: pre-issued token (skips password grant if set)
# FHIR_ACCESS_TOKEN=

# Optional: only upload these resource types (comma-separated). Empty = all.
# FHIR_RESOURCE_TYPES=Questionnaire,PlanDefinition,Library,StructureMap,ValueSet,Binary,Composition

# Optional: dry-run (print actions, no HTTP)
# DRY_RUN=1
