<mxfile host="tricc-tests">
  <diagram name="Triage" id="triagePage0000000001">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <object odk_type="start" label="Triage" id="tr-start-000000001">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1">
