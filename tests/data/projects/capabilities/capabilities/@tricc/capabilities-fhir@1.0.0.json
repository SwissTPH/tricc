  "functions": ["Abs", "AgeInDays", "AgeInMonths", "AgeInYears", "Coalesce", "Concatenate", "Count", "DateTimeToDecimal", "DiagnosisList", "FormatDate", "GetConditionValue", "GetContentVersion", "GetEncounterConditionValue", "GetEncounterObservationValue", "GetEncounterValue", "GetFacilityValue", "GetHistoryCondition", "GetHistoryConditionValue", "GetHistoryObservation", "GetHistoryObservationCodesSince", "GetHistoryObservationSince", "GetHistoryObservationValue", "GetHistoryObservationValueSince", "GetLocationValue", "GetObservationValue", "GetPatientValue", "GetPractitionerValue", "GetRepeatedValue", "Integer", "Length", "Max", "Min", "Now", "Round", "Sum", "ToBoolean", "ToDate", "ToDecimal", "ToInteger", "ToString", "Today"],
  "retrieval_contexts": ["patient", "facility", "practitioner", "location", "encounter", "history", "custom"],
  "populate_contexts": ["patient", "facility", "practitioner", "location", "encounter", "history"],
  "data_types": ["note", "select_one", "select_multiple", "select_yesno", "integer", "decimal", "text", "date", "quantity"],
  "features": [],
