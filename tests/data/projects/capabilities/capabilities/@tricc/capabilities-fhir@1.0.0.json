    "CAST_DATE": ["inline", "library"],
    "CAST_INTEGER": ["inline", "library"],
    "CAST_NUMBER": ["inline", "library"],
    "CAST_STRING": ["inline", "library"],
    "COALESCE": ["inline", "library"],
    "CONCATENATE": ["inline", "library"],
    "CONTAINS": ["inline", "library"],
    "CONTENT_VERSION": ["inline", "library"],
    "COUNT": ["inline", "library"],
    "DATETIME_TO_DECIMAL": ["inline", "library"],
    "DIAGNOSIS_LIST": ["inline", "library"],
    "DIVIDED": ["inline", "library"],
    "EQUAL": ["inline", "library"],
    "EXISTS": ["inline", "library"],
    "FLOOR": ["inline", "library"],
    "FORMAT_DATE": ["library"],
    "GET_INHERITED_VALUE": ["inline", "library"],
    "GET_REPEATED_VALUE": ["inline", "library"],
    "IF": ["inline", "library"],
    "IFS": ["inline", "library"],
    "ISFALSE": ["inline", "library"],
    "ISNOTFALSE": ["inline", "library"],
    "ISNOTNULL": ["inline", "library"],
    "ISNOTTRUE": ["inline", "library"],
    "ISNULL": ["inline", "library"],
    "ISTRUE": ["inline", "library"],
    "LENGTH": ["inline", "library"],
    "LESS": ["inline", "library"],
    "LESS_OR_EQUAL": ["inline", "library"],
    "LIST_IF": ["inline", "library"],
    "MAX": ["library"],
    "MIN": ["library"],
    "MINUS": ["inline", "library"],
    "MODULO": ["inline", "library"],
    "MORE": ["inline", "library"],
    "MORE_OR_EQUAL": ["inline", "library"],
    "MULTIPLIED": ["inline", "library"],
    "NATIVE": ["inline", "library"],
    "NOT": ["inline", "library"],
    "NOTEQUAL": ["inline", "library"],
    "NOTEXISTS": ["inline", "library"],
    "NOW": ["inline", "library"],
    "OR": ["inline", "library"],
    "PARENTHESIS": ["inline", "library"],
    "PLUS": ["inline", "library"],
    "POWER": ["inline", "library"],
    "ROUND": ["inline", "library"],
    "SELECTED": ["inline", "library"],
    "SUM": ["library"],
    "TODAY": ["inline", "library"]
