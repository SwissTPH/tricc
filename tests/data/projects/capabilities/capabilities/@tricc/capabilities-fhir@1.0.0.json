{
  "$schema": "https://tricc.org/schemas/capability-statement.schema.json",
  "id": "@tricc/capabilities-fhir",
  "version": "1.0.0",
  "strategy": "FHIRStrategy",
  "description": "FHIR SDC Questionnaire with CQL libraries; inline = FHIRPath, library = CQL.",
