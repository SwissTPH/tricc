        <object label="ds_diazepam" odk_type="calculate" reference="case &#xa;when &quot;p_weight&quot;&lt;5 then &#39;0.5&#39;&#xa;when &quot;p_weight&quot;&lt;10 and &quot;p_weight&quot;&gt;=5 then &#39;1&#39;&#xa;when &quot;p_weight&quot;&lt;14 and &quot;p_weight&quot;&gt;=10 then &#39;1.5&#39;&#xa;when &quot;p_weight&quot;&gt;= 14 then &#39;2&#39;&#xa;when &quot;p_age&quot;&lt;6 then &#39;0.5&#39;&#xa;when &quot;p_age&quot;&lt;12 and &quot;p_age&quot;&gt;6 then &#39;1&#39;&#xa;when &quot;p_age&quot;&gt;=12 and &quot;p_age&quot;&lt;36 then &#39;1.5&#39;&#xa;when &quot;p_age&quot;&gt;= 36 and &quot;p_age&quot;&lt;60 then&#39;2&#39;&#xa;else 0&#xa;end" name="ds_diazepam" id="NuzFfZ_v7NcCZYilb7cy-22">
