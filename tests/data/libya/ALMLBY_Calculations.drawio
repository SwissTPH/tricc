        <object label="ds_ORSplanB" odk_type="calculate" reference="case &#xa;when &quot;p_age&quot;&lt;=4 and &quot;p_weight&quot;&lt;6 then &#39;200-450&#39;&#xa;when &quot;p_age&quot;&lt;=12 and &quot;p_age&quot;&gt;4 and &quot;p_weight&quot;&gt;=6 and &quot;p_weight&quot;&lt;10 then &#39;450-800&#39;&#xa;when &quot;p_age&quot;&lt;=24 and &quot;p_age&quot;&gt;12 and &quot;p_weight&quot;&gt;=10 and &quot;p_weight&quot;&lt;12 then &#39;800-960&#39;&#xa;when &quot;p_age&quot;&lt;=60 and &quot;p_age&quot;&gt;24 and &quot;p_weight&quot;&gt;=12 and &quot;p_weight&quot;&lt;20 then &#39;960-1600&#39; &#xa;else &#39;-&#39; &#xa;end" name="ds_ORSplanB" id="NuzFfZ_v7NcCZYilb7cy-41">
