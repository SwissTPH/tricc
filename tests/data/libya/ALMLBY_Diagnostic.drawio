                <UserObject label="fever" odk_type="goto" name="goto_" link="data:page/id,B6XjKFMno-qqVuLHLWRe" id="tUSajpzN80rxI9W4hgEh-2">
                    <mxCell style="shape=offPageConnector;whiteSpace=wrap;html=1;rounded=0;fontSize=12;strokeColor=default;fillColor=none;" parent="1" vertex="1">
                        <mxGeometry x="191" y="1150" width="80" height="80" as="geometry"/>
                    </mxCell>
                </UserObject>
                <mxCell id="EW345LdB_qBMf1Z_IvKO-3" value="&amp;gt;0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="rmxIkyaFYGQDIE8Ccdyy-10" target="rmxIkyaFYGQDIE8Ccdyy-3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <object label="&lt;p&gt;1. Turn the child to his/her side and clear the airway. Avoid putting things in the mouth&lt;/p&gt;&lt;p&gt;2. &lt;b&gt;Give ${ds_diazepam_dosage_mg} mg Diazepam now!&lt;/b&gt; For this child inject &lt;b&gt;one dose of ${ds_diazepam} ml of DIAZEPAM (5mg/ml) injection solution&lt;/b&gt;&amp;nbsp;per rectum using a small syringe withou needle or using a catheter.&lt;/p&gt; &lt;p&gt;3. If convulsions have not stopped after 10 minutes give that dose of diazepam rectally a second time.&lt;/p&gt; &lt;p&gt;4. Give oxygen and continue with pre-referral treatment&lt;/p&gt; &lt;p&gt;5. Contact a Paediatric Specialist and ask how to continue treatment if the convulsion doesn't stop after the second dose of Diazepam&lt;/p&gt;" odk_type="note" name="label_diazepam_ds" id="rmxIkyaFYGQDIE8Ccdyy-5">
                    <mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=none;fontSize=12;strokeColor=default;" parent="1" vertex="1">
                        <mxGeometry x="735" y="560" width="420" height="190" as="geometry"/>
                    </mxCell>
                </object>
                <mxCell id="tUSajpzN80rxI9W4hgEh-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="pFXxp4cGxzIcWMCJU8rP-3" target="rmxIkyaFYGQDIE8Ccdyy-5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="tUSajpzN80rxI9W4hgEh-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="pFXxp4cGxzIcWMCJU8rP-1" target="rmxIkyaFYGQDIE8Ccdyy-5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="tUSajpzN80rxI9W4hgEh-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="pFXxp4cGxzIcWMCJU8rP-2" target="rmxIkyaFYGQDIE8Ccdyy-5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <object label="&lt;u&gt;Instructions for Diazepam application:&lt;/u&gt;&lt;br&gt;&lt;div&gt;Open the diazepam tube, lay the child prone and insert gently into the &lt;/div&gt;anus. Squeeze the entire content of the tube into the rectum, take the &lt;br&gt;tube out and hold the buttocks closed for some seconds. &lt;br&gt;Place the child on the side in a recovery position and secure the airways. " odk_type="help-message" id="pFXxp4cGxzIcWMCJU8rP-2">
                    <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#72bf44;strokeColor=#FF0080;align=left;fontSize=12;" parent="1" vertex="1">
                        <mxGeometry x="865" y="410" width="320" height="90" as="geometry"/>
                    </mxCell>
                </object>
