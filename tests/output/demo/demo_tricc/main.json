    {
      "linkId": "demo_angry",
      "text": "contains: SelectMultiple|select_why|0|1|Why ? contains 'demo.angry'",
      "type": "string",
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-hidden",
          "valueBoolean": true
