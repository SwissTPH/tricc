    {
      "linkId": "demo_discuss",
      "text": "We will discuss how we could make it better",
      "type": "string",
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-enableWhenExpression",
          "valueExpression": {
            "language": "text/fhirpath",
            "expression": "true"
          }
        }
