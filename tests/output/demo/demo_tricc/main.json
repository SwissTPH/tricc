      ]
    },
    {
      "linkId": "demo_bored",
      "text": "contains: SelectMultiple|select_why|0|1|Why ? contains 'demo.bored'",
      "type": "string",
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-hidden",
          "valueBoolean": true
        },
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
          "valueExpression": {
            "language": "text/fhirpath",
            "expression": "(%resource.repeat(item).where(linkId='select_why').answer contains 'demo.bored')"
          }
