# Copy this file into your clinical project folder (outside the TRICC repo)
# as tricc.yaml (or tricc.yml), next to common/, child/, …
#
# After installing tricc-oo (`pip install tricc-oo` or an editable install):
#   cd /path/to/your/project
#   tricc -o ./build
#
# -i defaults to the current directory. -o defaults to ./output if omitted.
# Specs: feature/20260907-project-config.md, feature/20260907-intervention-start.md

# Name of the whole programme.
title: My project

# How drawings are read. Default: DrawioStrategy. CLI -I overrides this.
input_strategy: DrawioStrategy

# One or more exporters, run in this order. CLI -O replaces this list.
# Examples: XLSFormStrategy, XLSFormCHTStrategy, XLSFormCDSSStrategy, OpenSRPStrategy, FHIRStrategy
output_strategies:
  - XLSFormCHTStrategy

# Flat key: value tunables. Unknown keys are kept for later.
parameters:
  # Must match the installed tricc-oo version exactly, or the build fails.
  # Omit this key to skip the check.
  tricc_version: "1.7.3"
  # Pixel caps for images extracted from draw.io. 0 or omit = no cap.
  # A single image shape may set max_width / max_height (Edit Data) to override one side.
  image_max_width: 0
  image_max_height: 0

# Each entry is one algorithm. Omit this list to keep today's behaviour
# (every top-level drawing in -i is one implicit on-demand intervention).
#
# Paths are relative to this file. common/* is one folder level only
# (not common/labs/*.drawio — add common/labs/* for that).
# Google Drive file or folder URLs may be mixed with local globs:
#   - https://drive.google.com/drive/folders/…
#   - https://drive.google.com/file/d/…/view
# Restricted Drive needs auth/google.json (or TRICC_GOOGLE_AUTH).
# The same glob may appear on several interventions; each intervention is
# converted separately (shared files are read once per intervention).
#
# start: when a health worker can open this intervention.
#   on: demand     — app button, available whenever condition is true
#   on: follow_up  — task due after another intervention is submitted
# condition is CQL (same dialect as rhombus / calculate labels).
# due / window use UCUM time units only: s, min, h, d, wk, mo (mo = 30 d).
# start may be a list if one intervention is both on demand and a follow-up.
# kind and applicability are gone; use start instead.
interventions:
  - id: pediatrics                    # machine name; used in output folders
    title: Pediatrics                 # form title
    description: IMCI for children from 2 months to 5 years
    activity:
      - common/*
      - child/*
      # Drive file or folder URLs are allowed next to local globs:
      # - https://drive.google.com/drive/folders/YOUR_FOLDER_ID
    start:
      on: demand
      condition: "AgeInMonths() >= 2 and AgeInMonths() < 60"
  - id: pediatrics_followup
    title: Pediatrics follow-up
    description: Revisit after a pneumonia classification
    activity:
      - common/*
      - followup/*
    start:
      on: follow_up
      intervention: pediatrics        # parent id; clock starts on its submission
      condition: "classification = 'pneumonia'"
      due: 3 d                        # when the task is due
      window:
        before: 0 d                   # how long before due it appears
        after: 4 d                    # how long after due it stays
  - id: young_infants
    title: Young infants
    description: IMCI for young infants under 2 months
    activity:
      - common/*
      - young_infant/*
    start:
      on: demand
      condition: "AgeInMonths() < 2"

# Output directory is still CLI -o (not a key here).
# With interventions the layout is: { -o }/{strategy}/{intervention_id}/

